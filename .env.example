# ---- Database ---------------------------------------------------------------
# Any Postgres works: Neon, Supabase, Railway, local. Needs SSL on most hosts.
#
# On Neon use the DIRECT endpoint (no "-pooler" in the hostname). The
# transaction-mode pooler is incompatible with Prisma interactive transactions
# and bidding dies with P2028 "Transaction not found".
# The catch with the direct endpoint is the connection cap: Prisma's default
# pool is (CPU cores * 2 + 1), which overruns it and surfaces as
# "Can't reach database server" (P1001). Set `connection_limit` explicitly and
# keep it small — 3 is plenty for a single app instance.
# `pool_timeout` (seconds) queues while the connection is established.
DATABASE_URL="postgresql://user:password@host:5432/gavl?sslmode=require&connection_limit=3&pool_timeout=20"

# ---- Auth -------------------------------------------------------------------
# Secret used to sign session JWTs. Generate one: `openssl rand -base64 32`
AUTH_SECRET="replace-me-with-a-long-random-string"
# Set to "true" ONLY when serving over HTTPS (marks the session cookie Secure).
# Leave unset/false for local http://localhost or login will break.
COOKIE_SECURE="false"

# ---- Realtime / app ---------------------------------------------------------
# Public origin the browser uses to reach the Socket.io server (same process).
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"
PORT=3000

# ---- Auction tuning (server-authoritative, all optional) --------------------
# Seconds before ends_at that a bid triggers an anti-snipe extension.
ANTISNIPE_WINDOW_SECONDS=30
# When time-left drops below this, a listing flips to ENDING_SOON.
ENDING_SOON_SECONDS=300
# Leaderboard scoring metric: WINNING_VALUE | BID_VOLUME | BID_COUNT
SCORING_METRIC="WINNING_VALUE"
# How long a Weekly Showdown stays live once it opens (hours).
SHOWDOWN_DURATION_HOURS=168
