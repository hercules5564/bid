# ---- Database ---------------------------------------------------------------
# Any Postgres works: Neon, Supabase, Railway, local. Needs SSL on most hosts.
#
# On Neon use the DIRECT endpoint (no "-pooler" in the hostname). The
# transaction-mode pooler is incompatible with Prisma interactive transactions
# and bidding dies with P2028 "Transaction not found".
# The catch with the direct endpoint is the connection cap: Prisma's default
# pool is (CPU cores * 2 + 1), which overruns it and surfaces as
# "Can't reach database server" (P1001). Set `connection_limit` explicitly and
# keep it small — 3 is plenty for a single app instance.
# `pool_timeout` (seconds) queues while the connection is established.
DATABASE_URL="postgresql://user:password@host:5432/gavl?sslmode=require&connection_limit=3&pool_timeout=20"

# ---- Auth -------------------------------------------------------------------
# Secret used to sign session JWTs. Generate one: `openssl rand -base64 32`
AUTH_SECRET="replace-me-with-a-long-random-string"
# Set to "true" ONLY when serving over HTTPS (marks the session cookie Secure).
# Leave unset/false for local http://localhost or login will break.
COOKIE_SECURE="false"

# ---- Realtime / app ---------------------------------------------------------
# Public origin the browser uses to reach the Socket.io server (same process).
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"
PORT=3000

# ---- Auction tuning (server-authoritative, all optional) --------------------
# Seconds before ends_at that a bid triggers an anti-snipe extension.
ANTISNIPE_WINDOW_SECONDS=30
# When time-left drops below this, a listing flips to ENDING_SOON.
ENDING_SOON_SECONDS=300
# Leaderboard scoring metric: WINNING_VALUE | BID_VOLUME | BID_COUNT
SCORING_METRIC="WINNING_VALUE"
# How long a Weekly Showdown stays live once it opens (hours).
SHOWDOWN_DURATION_HOURS=168

# ---- USDT escrow (buyer -> Gavl -> seller) ----------------------------------
# Only USDT is accepted. Buyer pays Gavl, Gavl keeps fee, sends rest to seller.
# Paste your Bybit USDT-TRC20 address here once you have it.
PLATFORM_FEE_PERCENT=5
ESCROW_USDT_ADDRESS=""
ESCROW_NETWORK="TRC20 (Tron)"

# ---- Wallet (prepaid USDT bidding balance) ----------------------------------
# Max single top-up in USDT. Demo signup bonus in rupees (0 disables it).
WALLET_MAX_TOPUP_USDT="10000"
WALLET_SIGNUP_BONUS_RUPEES="50000"

# ---- Bybit Pay (real USDT payments, optional) ---------------------------------
# Leave empty to hide Bybit Pay (manual USDT escrow flow only). When set,
# checkout shows "Pay with Bybit" (QR for the Bybit app) and dispute refunds
# happen on-chain via Bybit's refund API.
# Onboarding: apply as a Bybit Pay merchant (KYB) -> you get a merchant UID
# (merchantId) and an API key. Generate an RSA keypair locally
# (`openssl genrsa -out bybit.pem 2048`), upload the PUBLIC key to Bybit,
# and paste the PRIVATE key below (keep the \n escapes on one line).
# Docs: https://bybit-exchange.github.io/pay-docs/ (scan-payment)
BYBIT_PAY_BASE_URL="https://api.bybit.com"
BYBIT_PAY_API_KEY=""
BYBIT_PAY_MERCHANT_ID=""
BYBIT_PAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Bybit's platform RSA public key (for verifying webhooks) — from Bybit docs.
BYBIT_PAY_PLATFORM_PUBLIC_KEY=""
# Public URL of this app (payment return + webhook callbacks).
BYBIT_PAY_WEBHOOK_URL="https://your-domain/api/payments/bybit/webhook"
# ₹ per USDT conversion rate (lots are priced in ₹, Bybit pays USDT).
BYBIT_USDT_INR_RATE="90"
# MCC category for lots (5999 = miscellaneous retail; official list in Bybit docs).
BYBIT_PAY_MCC_CODE="5999"

# ---- Razorpay (credit/debit cards, UPI, netbanking) ---------------------------
# Checkout + wallet top-up show "Pay with card" when these are set. Start in
# TEST mode (dashboard Mode toggle): test keys move no real money, and you can
# pay with Razorpay's test cards (e.g. 4111 1111 1111 1111). Flip to live keys
# when ready. Webhook: add https://your-domain/api/payments/razorpay/webhook
# in dashboard Settings → Webhooks (event: payment.captured).
# Docs: https://razorpay.com/docs/api/orders/ · https://razorpay.com/docs/webhooks/
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
